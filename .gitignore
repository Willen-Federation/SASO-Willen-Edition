# --- Secrets & local environment ---
.env
.env.local
.env.*.local
config.local.json
config_*.json
!config.example.json

# --- Composer (vendor is bundled only in release ZIPs, not committed) ---
/vendor/
composer.phar

# --- Node (mkdocs / tooling) ---
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# --- Python (mkdocs) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- MkDocs build output ---
/site/

# --- PHP tooling caches ---
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan/
.phpstan.cache
phpstan.tmp.neon

# --- Test reports ---
/coverage/
/build/
*.lcov

# --- App runtime data ---
/logs/
/tmp/
/cache/
/uploads/*
!/uploads/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep

# --- Installer lock (set by completed installs) ---
/installer/installer.json

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

