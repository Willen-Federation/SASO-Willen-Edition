# --- Secrets & local environment ---
.env
.env.local
.env.*.local
# tools/repair-app-key.php side files
.env.backup.*
.env.lock
.env.tmp.*
config.local.json
config_*.json
!config.example.json

# --- Composer (vendor is bundled only in release ZIPs, not committed) ---
/vendor/
composer.phar

# --- Node (mkdocs / tooling) ---
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# --- Python (mkdocs) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- MkDocs build output ---
/site/

# --- PHP tooling caches ---
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan/
.phpstan.cache
phpstan.tmp.neon

# --- Test reports ---
/coverage/
/build/
*.lcov

# --- App runtime data ---
/logs/
/tmp/
/cache/
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess

# The install wizard at `installer/installer.json` is intentionally tracked
# (fresh clones need it to activate the wizard routes). The wizard removes
# this file when it finishes; operators who re-run install restore it from
# git.

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- OS / archive temporaries ---
*.zip
!dist/saso-*.zip
*.tar.gz
*.log

# --- Claude Code workspace files (per-developer) ---
.claude/
.serena/
GEMINI.md
SKILL.md
