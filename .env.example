# =============================================================================
# SASO — Willen Edition / environment configuration
# =============================================================================
# Copy this file to `.env` in the same directory and fill in your secrets.
#
#   cp .env.example .env
#   $EDITOR .env
#
# `.env` is git-ignored. Any value set here overrides the corresponding entry
# in `config.json` for the keys listed below; everything else stays in
# `config.json` (and, after milestone M4, in the `system_setting` table that
# is editable from the admin Web UI).
#
# Resolution order for each key (highest first):
#   1. this `.env` file
#   2. real OS environment variable of the same name
#   3. value from `config.json`
# =============================================================================

# -----------------------------------------------------------------------------
# Database connection (recommended to set here rather than config.json)
# -----------------------------------------------------------------------------
# Format: mysql:host=<host>;dbname=<db>;charset=utf8mb4
DB_DSN=mysql:host=localhost;dbname=saso_db;charset=utf8mb4
DB_USER=saso_user
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Security toggles
# -----------------------------------------------------------------------------
# Enables the in-app HTTPS redirect, the HSTS header, and the `Secure` flag
# on the session cookie. Set to `true` in production behind TLS, `false`
# during local development without TLS.
APP_HTTPS=false

# -----------------------------------------------------------------------------
# Server-side webhook secret for POST /webhock and /webhook.
# Send as X-Webhook-Token. Tokens in query strings are intentionally not
# supported because they are commonly persisted in access logs and browser
# history.
# Generate manually with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# APP_KEY — AES-256-GCM master key used by SecretEncryptor to encrypt
# auth_provider.client_secret_encrypted (OIDC client secrets, SAML keys at rest).
# Accepted formats:
#   - base64-encoded 32 bytes (44 chars with padding)  [recommended]
#   - hex-encoded 32 bytes (64 hex chars)
#   - any string of at least 32 characters (hashed via SHA-256 before use)
# Required: the application refuses to boot the API/MCP if APP_KEY is missing
# or shorter than 32 characters — no insecure default is provided.
# Generate manually with:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
APP_KEY=

# -----------------------------------------------------------------------------
# JWT_SECRET — HMAC-SHA256 signing secret for the mobile/MCP JWT access tokens
# issued by POST /api/v1/mobile/connect. Must be at least 32 bytes.
# If unset, the application falls back to deriving an HS256 key from APP_KEY.
# At least one of JWT_SECRET or APP_KEY (≥ 32 chars) is required — the
# application refuses to boot the API/MCP otherwise.
# Generate manually with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# Document root overrides (Docker / CI)
# config.json ships with the production server path. In Docker the app runs at
# /var/www/html/saso, so set these to match your docker-compose volume mount.
# Leave blank to let ConfigLoader.php auto-detect from __DIR__ (works for most
# local setups; the hardcoded production path is replaced automatically).
# APP_DOCUMENT_ROOT=/var/www/html/saso/
# APP_PROGRAM_DIR=

# -----------------------------------------------------------------------------
# Application seeding (database initialization)
# Default credentials are used if these are not set. The Member.id constraint
# requires 8-20 characters, so defaults are: admin_test / test123456
# For custom credentials, ensure the admin ID is 8-20 alphanumeric characters.
#
# Usage: make migrate && make seed
# After seeding, login with SEED_ADMIN_ID and SEED_ADMIN_PASSWORD
# -----------------------------------------------------------------------------
SEED_ADMIN_ID=admin_test
SEED_ADMIN_PASSWORD=test123456
