{
    "name": "willen-federation/saso-willen-edition",
    "description": "Open-source inventory & warehouse management in PHP — barcodes, label printing (PDF), shelf management. Willen Federation fork of Japan Standards Organization's SASO.",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "inventory-management",
        "warehouse-management",
        "barcode",
        "label-printing",
        "pdf-generation",
        "tcpdf",
        "self-hosted"
    ],
    "homepage": "https://github.com/Willen-Federation/SASO-Willen-Edition",
    "support": {
        "issues": "https://github.com/Willen-Federation/SASO-Willen-Edition/issues",
        "source": "https://github.com/Willen-Federation/SASO-Willen-Edition",
        "security": "https://github.com/Willen-Federation/SASO-Willen-Edition/security/advisories"
    },
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-zip": "*",
        "jumbojett/openid-connect-php": "^1.0",
        "monolog/monolog": "^3.7",
        "nikic/fast-route": "^1.3",
        "onelogin/php-saml": "^4.1",
        "open-feature/sdk": "^2.0",
        "symfony/messenger": "^7.2",
        "symfony/translation": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.58",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5",
        "roave/security-advisories": "dev-latest",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "Saso\\": "src/"
        },
        "files": [
            "src/Infrastructure/Translation/functions.php",
            "framework/ui/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Saso\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "analyse": "Run static analysis with PHPStan.",
        "cs:check": "Verify code style without modifying files.",
        "cs:fix": "Apply PSR-12 / project code-style fixes in place."
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
