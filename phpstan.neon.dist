includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    # Scope: only files this fork has rewritten or owns. Legacy directories
    # (auth/, item/, framework/, repository/, etc.) are deliberately excluded
    # — they migrate to src/ across M3-M4 and will be re-included once they
    # carry strict types and proper interface contracts. Adding them at L6
    # today would produce hundreds of pre-existing magic-property and
    # mixed-type errors that bury actionable signal.
    paths:
        - src
        - tests
        - util/EnvLoader.php
        - util/UploadValidator.php
        - util/CSRFtoken.php
    # Phinx migrations are class-based but resolved at runtime by Phinx
    # via direct require_once. Listing the directory under scanDirectories
    # makes the class symbols visible to the test reflection helpers
    # without forcing the migrations themselves through level-6 analysis
    # (Phinx's AbstractMigration relies on magic methods we have no
    # reason to type-narrow).
    scanDirectories:
        - migrations
    excludePaths:
        analyseAndScan:
            - vendor/*
            - extention/*
            # DbProvider implements OpenFeature interfaces from a library that
            # is not installed in this fork. Excluded until the OpenFeature SDK
            # is properly added as a composer dependency.
            - src/Infrastructure/FeatureFlag/DbProvider.php
    bootstrapFiles:
        - tests/bootstrap.php
    parallel:
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 2
    treatPhpDocTypesAsCertain: true
    reportUnmatchedIgnoredErrors: true
