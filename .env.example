# =============================================================================
# SASO — Willen Edition / environment configuration
# =============================================================================
# Copy this file to `.env` in the same directory and fill in your secrets.
#
#   cp .env.example .env
#   $EDITOR .env
#
# `.env` is git-ignored. Any value set here overrides the corresponding entry
# in `config.json` for the keys listed below; everything else stays in
# `config.json` (and, after milestone M4, in the `system_setting` table that
# is editable from the admin Web UI).
#
# Resolution order for each key (highest first):
#   1. this `.env` file
#   2. real OS environment variable of the same name
#   3. value from `config.json`
#
# Quickstart: `make up` (or `docker compose up`) auto-generates a usable `.env`
# with secure random values for APP_KEY / DB_PASSWORD / MARIADB_ROOT_PASSWORD
# on first run. The blocks below describe what each value means.
# =============================================================================

# -----------------------------------------------------------------------------
# Database connection (recommended to set here rather than config.json)
# -----------------------------------------------------------------------------
# Format: mysql:host=<host>;dbname=<db>;charset=utf8mb4
DB_DSN=mysql:host=localhost;dbname=saso_db;charset=utf8mb4
DB_USER=saso_user
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Security toggles
# -----------------------------------------------------------------------------
# Enables the in-app HTTPS redirect, the HSTS header, and the `Secure` flag
# on the session cookie. Set to `true` in production behind TLS, `false`
# during local development without TLS.
APP_HTTPS=false

# -----------------------------------------------------------------------------
# Filesystem layout overrides — only set on hosts where the document root /
# program subdirectory diverge from the values shipped in config.json. Useful
# for cPanel/LiteSpeed deployments where paths like
# `/home/<account>/domains/<host>/public_html/` cannot live in a tracked file.
# Leave commented out to use the values from config.json.
# -----------------------------------------------------------------------------
#APP_DOCUMENT_ROOT=/var/www/html/
#APP_PROGRAM_DIR=/saso/

# -----------------------------------------------------------------------------
# Application encryption key (REQUIRED) — base64-encoded 32 bytes.
# Used by SecretEncryptor to encrypt OAuth client secrets and other at-rest
# sensitive data. Auto-generated on first `make up` / `docker compose up`.
# Generate manually with:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
APP_KEY=

# -----------------------------------------------------------------------------
# Server-side webhook secret for POST /webhock and /webhook.
# Send as X-Webhook-Token. Tokens in query strings are intentionally not
# supported because they are commonly persisted in access logs and browser
# history.
# Generate manually with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# MariaDB root password (Docker stack only) — auto-generated on first run.
# Ignored outside the docker-compose stack.
# -----------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=

# =============================================================================
# Optional developer overrides
# -----------------------------------------------------------------------------
# Production stores these in the `system_setting` DB table (encrypted),
# editable via the admin Web UI:
#   AI provider keys → /admin/ai-settings
#   Auth0 settings   → /admin/auth-providers
#
# The values below are read by the app only when the corresponding DB row is
# absent — useful for a fresh clone with no admin user yet, or for a
# "force mode" run where you want env vars to win without touching the UI.
# Leave blank if you don't need them.
# =============================================================================

# AI provider — gemini | openai | anthropic
AI_PROVIDER=
LOCAL_GEMINI_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth0 (developer override only)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Keycloak local IdP (only used with `make up-sso`)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
